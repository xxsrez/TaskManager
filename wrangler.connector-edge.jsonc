{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-manager-uat-connector",
  "main": "worker/connector-edge.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "TASK_MANAGER_CONNECTOR_EDGE_RATE_LIMITER",
      "namespace_id": "294001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]

  // Add exact non-secret upstream/public origins only after the public Worker
  // origin is known. Store TASK_MANAGER_CONNECTOR_EDGE_SITES_BYPASS_TOKEN with
  // `wrangler secret put`; never add it to this file or a command argument.
}
