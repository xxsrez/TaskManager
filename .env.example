# Comma-separated verified emails that can open the server-gated admin surface.
TASK_MANAGER_ADMIN_EMAILS=

# Optional canonical public origin for OAuth metadata and resource audience.
# Production defaults to the incoming Sites origin when empty.
TASK_MANAGER_PUBLIC_ORIGIN=

# Comma-separated HTTPS origins allowed to publish OAuth Client ID Metadata.
TASK_MANAGER_OAUTH_CLIENT_ORIGINS=https://chatgpt.com

# Non-secret native attachment limits. Hosted UAT/production values may differ,
# but their scope and R2 buckets must never be shared.
TASK_MANAGER_ATTACHMENT_SCOPE=local
TASK_MANAGER_ATTACHMENT_MAX_BYTES=26214400
TASK_MANAGER_ATTACHMENT_MAX_COUNT=50
TASK_MANAGER_ATTACHMENT_MAX_OWNER_BYTES=2147483648
TASK_MANAGER_ATTACHMENT_MAX_PROJECT_BYTES=1073741824
TASK_MANAGER_ATTACHMENT_MAX_IMAGE_PIXELS=40000000
TASK_MANAGER_ATTACHMENT_UPLOAD_TIMEOUT_SECONDS=900
TASK_MANAGER_ATTACHMENT_DELETE_GRACE_SECONDS=604800
TASK_MANAGER_ATTACHMENT_FAILED_RETENTION_SECONDS=86400
