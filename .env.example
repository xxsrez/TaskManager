# Comma-separated verified emails that can open the server-gated admin surface.
TASK_MANAGER_ADMIN_EMAILS=

# Optional canonical public origin for OAuth metadata and resource audience.
# Production defaults to the incoming Sites origin when empty.
TASK_MANAGER_PUBLIC_ORIGIN=

# Comma-separated HTTPS origins allowed to publish OAuth Client ID Metadata.
TASK_MANAGER_OAUTH_CLIENT_ORIGINS=https://chatgpt.com
